        // جلب السعر الحقيقي الحي
        async function fetchRealMarketPrice(symbol) {
            try {
                if (symbol.includes("XAUUSD")) {
                    let res = await fetch('https://api.gold-api.com/price/XAU');
                    let data = await res.json();
                    return parseFloat(data.price);
                } else if (symbol.includes("BTCUSDT")) {
                    let res = await fetch('https://api.binance.com/api/v3/ticker/price?symbol=BTCUSDT');
                    let data = await res.json();
                    return parseFloat(data.price);
                } else {
                    return 4357.10;
                }
            } catch (e) {
                return 4357.10;
            }
        }

