<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark" id="htmlRoot">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title id="appTitle">Titan Quantum AI - النظام المتكامل</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { darkMode: 'class' }</script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: system-ui, -apple-system, sans-serif; transition: background 0.3s, color 0.3s; }
        .glow-box { box-shadow: 0 0 25px rgba(16, 185, 129, 0.08); }
        .glow-vision { box-shadow: 0 0 30px rgba(59, 130, 246, 0.12); }
    </style>
</head>
<body class="bg-[#030508] text-slate-100 min-h-screen flex flex-col font-sans pb-24" id="bodyTheme">

    <!-- الشريط العلوي -->
    <header id="headerTheme" class="bg-[#090d14]/90 backdrop-blur border-b border-slate-800/80 px-4 py-3 flex justify-between items-center sticky top-0 z-50">
        <div class="flex items-center space-x-3 space-x-reverse">
            <div id="topIconBox" class="w-9 h-9 bg-emerald-500/10 border border-emerald-500/30 rounded-xl flex items-center justify-center text-emerald-400 font-black text-sm">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div>
                <h1 id="brandTitle" class="font-black text-xs text-white tracking-wider">TITAN QUANTUM AI</h1>
                <p id="brandSub" class="text-[9px] text-emerald-400 font-bold">نظام التحليل العميق والمفلتر لكافة الأسواق</p>
            </div>
        </div>
        
        <div onclick="openTab('profile')" class="w-8 h-8 rounded-full bg-slate-800 border border-slate-700 overflow-hidden cursor-pointer flex items-center justify-center shadow-md">
            <img id="topAvatarImg" src="" class="w-full h-full object-cover hidden">
            <i id="topAvatarIcon" class="fa-solid fa-user text-xs text-slate-400"></i>
        </div>
    </header>

    <!-- المحتوى الرئيسي -->
    <main class="flex-1 p-3.5 flex flex-col gap-3.5 max-w-md mx-auto w-full">
        
        <!-- 1. الشاشة الرئيسية والشارت -->
        <section id="tab-home" class="space-y-3.5">
            <div id="boxTheme1" class="bg-[#090d14] border border-slate-800/80 p-3 rounded-2xl flex justify-between items-center shadow-md">
                <span class="text-xs font-bold text-slate-300 flex items-center gap-2">
                    <i class="fa-solid fa-server text-emerald-400"></i> <span data-lang="serverLabel">اختر الأصل / السوق:</span>
                </span>
                <select id="assetSelector" onchange="changeAsset(this.value)" class="bg-[#111622] border border-slate-700 text-emerald-400 text-xs rounded-xl px-3 py-2 outline-none font-bold shadow-sm">
                    <option value="OANDA:XAUUSD">الذهب (XAU/USD)</option>
                    <option value="BINANCE:BTCUSDT">البيتكوين (BTC/USD)</option>
                    <option value="FOREXCOM:SPXUSD">مؤشر S&P 500</option>
                    <option value="NASDAQ:AAPL">أسهم أبل (AAPL)</option>
                </select>
            </div>

            <div id="boxTheme2" class="bg-[#090d14] border border-slate-800/80 rounded-2xl overflow-hidden shadow-xl" style="height: 310px;">
                <div class="tradingview-widget-container w-full h-full" id="tv-chart-container"></div>
            </div>

            <!-- شريط الفحص العميق العشري الصارم -->
            <div id="scanningStatusBox" class="bg-[#090d14] border border-emerald-500/30 p-4 rounded-2xl hidden space-y-3 shadow-lg glow-box">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-black text-white flex items-center gap-1.5">
                        <i class="fa-solid fa-radar fa-spin text-emerald-400 text-sm"></i> <span data-lang="scanningText">الفحص الصارم عبر 10 مراحل</span>
                    </span>
                    <span id="scanPercentText" class="text-emerald-400 font-mono font-black text-xs">0%</span>
                </div>
                <p id="scanStepText" class="text-[10px] text-slate-400 font-bold leading-relaxed h-8">
                    جاري البدء بالمرحلة الأولى...
                </p>
                <div class="w-full bg-slate-900 h-2 rounded-full overflow-hidden border border-slate-800">
                    <div id="scanProgressBar" class="bg-gradient-to-r from-emerald-600 via-emerald-400 to-teal-400 h-full w-0 transition-all duration-700 ease-in-out"></div>
                </div>
            </div>

            <button onclick="start10StageDeepScan()" id="triggerBtn" class="w-full bg-gradient-to-r from-emerald-600 via-teal-500 to-emerald-600 text-slate-950 font-black py-4 px-4 rounded-2xl shadow-xl flex items-center justify-center gap-2 active:scale-95 transition text-xs">
                <i class="fa-solid fa-shield-halved text-base"></i> <span data-lang="startScanBtn">بدء الفحص الصارم (10 مراحل مضمونة)</span>
            </button>
        </section>

        <!-- 2. قسم تحليل الشارتات والصور الاحترافي -->
        <section id="tab-vision" class="space-y-3.5 hidden">
            <div class="flex justify-between items-center border-b border-slate-800 pb-2">
                <h2 class="font-black text-xs text-white flex items-center gap-2">
                    <i class="fa-solid fa-brain text-blue-400"></i> <span data-lang="visionTitle">التحليل العميق للشارت (AI Deep Vision)</span>
                </h2>
                <span class="text-[9px] bg-blue-500/10 text-blue-400 border border-blue-500/30 px-2 py-0.5 rounded-lg font-bold">10 مراحل صارمة</span>
            </div>

            <div class="bg-[#090d14] border border-slate-800 p-4 rounded-2xl space-y-3 shadow-xl">
                <div onclick="document.getElementById('chartUploadInput').click()" id="uploadDropZone" class="border-2 border-dashed border-slate-700 hover:border-blue-500/50 rounded-2xl p-6 text-center cursor-pointer transition flex flex-col items-center justify-center gap-2 bg-[#111622]/50 group">
                    <div class="w-12 h-12 rounded-2xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-400 text-lg group-hover:scale-110 transition">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-white" data-lang="uploadTitle">ارفع صورة الشارت لأي سوق تريده</p>
                        <p class="text-[9px] text-slate-400 mt-0.5" data-lang="uploadSub">ذهب، عملات رقمية، مؤشرات، أسهم، أو فوركس</p>
                    </div>
                </div>
                <input type="file" id="chartUploadInput" accept="image/*" class="hidden" onchange="handleChartUpload(event)">

                <div id="chartPreviewContainer" class="hidden relative rounded-xl overflow-hidden border border-slate-800 max-h-44 bg-black/40 flex items-center justify-center">
                    <img id="chartPreviewImg" class="w-full object-contain max-h-44">
                    <button onclick="clearChartUpload()" class="absolute top-2 left-2 bg-rose-500/80 hover:bg-rose-600 text-white p-1.5 rounded-lg text-xs transition">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div class="grid grid-cols-2 gap-2 pt-1">
                    <div>
                        <label class="text-[9px] text-slate-400 block mb-1 font-bold" data-lang="tfLabel">الفريم الزمني الظاهر:</label>
                        <select id="visionTimeframe" class="w-full bg-[#111622] border border-slate-700 text-blue-400 text-[10px] rounded-xl px-2.5 py-2 outline-none font-bold">
                            <option value="M15">فريم 15 دقيقة</option>
                            <option value="H1">فريم ساعة واحدة</option>
                            <option value="H4">فريم 4 ساعات (هيكلي عميق)</option>
                            <option value="D1">فريم يومي (استثماري طويل)</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-[9px] text-slate-400 block mb-1 font-bold" data-lang="strategyFocusLabel">الاستراتيجية المعتمدة:</label>
                        <select id="visionStrategy" class="w-full bg-[#111622] border border-slate-700 text-blue-400 text-[10px] rounded-xl px-2.5 py-2 outline-none font-bold">
                            <option value="smc">هيكل السوق والسيولة (SMC & Order Block)</option>
                            <option value="rsi_ema">متوسطات ومؤشر العزم (RSI & EMA)</option>
                            <option value="support_resistance">الدعوم والمقاومات الكلاسيكية</option>
                        </select>
                    </div>
                </div>

                <button onclick="startVisionAnalysis()" id="visionScanBtn" disabled class="w-full bg-slate-800 text-slate-500 font-black py-3.5 px-4 rounded-2xl flex items-center justify-center gap-2 transition text-xs cursor-not-allowed">
                    <i class="fa-solid fa-microchip text-base"></i> <span data-lang="startVisionBtn">بدء الفحص الصارم للشارت</span>
                </button>
            </div>

            <div id="visionStatusBox" class="bg-[#090d14] border border-blue-500/30 p-4 rounded-2xl hidden space-y-3 shadow-xl glow-vision">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-black text-white flex items-center gap-1.5">
                        <i class="fa-solid fa-atom fa-spin text-blue-400 text-sm"></i> <span data-lang="visionScanningText">جاري فحص الـ 10 مراحل للشارت...</span>
                    </span>
                    <span id="visionPercentText" class="text-blue-400 font-mono font-black text-xs">0%</span>
                </div>
                <p id="visionStepText" class="text-[10px] text-slate-400 font-bold leading-relaxed h-8">
                    فحص دقيق وشامل...
                </p>
                <div class="w-full bg-slate-900 h-2 rounded-full overflow-hidden border border-slate-800">
                    <div id="visionProgressBar" class="bg-gradient-to-r from-blue-600 via-indigo-500 to-cyan-400 h-full w-0 transition-all duration-700 ease-in-out"></div>
                </div>
            </div>

            <div id="visionResultContainer" class="space-y-3"></div>
        </section>

        <!-- 3. النتائج المفلترة لكل الاستراتيجيات -->
        <section id="tab-signals" class="space-y-3.5 hidden">
            <div class="flex justify-between items-center border-b border-slate-800 pb-2">
                <h2 class="font-black text-xs text-white flex items-center gap-2">
                    <i class="fa-solid fa-square-poll-vertical text-emerald-400"></i> <span data-lang="resultsTitle">نتائج استراتيجيات التداول الاحترافية</span>
                </h2>
                <button onclick="openTab('home')" class="text-[10px] bg-[#111622] border border-slate-800 px-2.5 py-1 rounded-lg text-emerald-400" data-lang="backBtn">رجوع للشارت</button>
            </div>

            <div id="isolatedSignalContent" class="space-y-3.5">
                <div class="bg-[#090d14] border border-slate-800 p-6 rounded-2xl text-center text-xs text-slate-500" data-lang="noResults">
                    لم يتم إجراء فحص بعد. انقر على بدء الفحص الصارم من الشاشة الرئيسية.
                </div>
            </div>
        </section>

        <!-- 4. صفحة الملف الشخصي والإعدادات -->
        <section id="tab-profile" class="space-y-4 hidden pb-10">
            <div class="flex justify-between items-center border-b border-slate-800 pb-2">
                <h2 class="font-black text-xs text-white flex items-center gap-2">
                    <i class="fa-solid fa-gear text-emerald-400"></i> <span data-lang="settingsTitle">الملف الشخصي والإعدادات الشاملة</span>
                </h2>
            </div>

            <div class="bg-[#090d14] border border-slate-800 p-4 rounded-2xl space-y-3 shadow-lg">
                <div class="flex items-center gap-3.5">
                    <div onclick="document.getElementById('fileInputStudio').click()" class="relative w-16 h-16 rounded-2xl bg-slate-800 border-2 border-emerald-500/40 overflow-hidden cursor-pointer flex items-center justify-center group shadow-md">
                        <img id="profileImgDisplay" src="" class="w-full h-full object-cover hidden">
                        <i id="profileIconDisplay" class="fa-solid fa-camera text-xl text-emerald-400 group-hover:scale-110 transition"></i>
                        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition flex items-center justify-center text-[9px] font-bold text-white">استديو</div>
                    </div>
                    <input type="file" id="fileInputStudio" accept="image/*" class="hidden" onchange="pickImageFromStudio(event)">

                    <div class="flex-1">
                        <label class="text-[9px] text-slate-400 block mb-1" data-lang="fullNameLabel">الاسم الكامل:</label>
                        <input type="text" id="userNameInput" value="حسن نعمان كاظم" class="w-full bg-[#111622] border border-slate-700 text-xs rounded-xl px-3 py-2 text-white font-bold outline-none focus:border-emerald-500">
                    </div>
                </div>
                <p class="text-[9px] text-slate-400 text-center font-bold" data-lang="studioHint">انقر على أيقونة الكاميرا لفتح استديو الهاتف واختيار صورتك الشخصية فوراً.</p>
            </div>

            <div class="bg-[#090d14] border border-slate-800 p-4 rounded-2xl space-y-3 shadow-lg">
                <h3 class="font-black text-xs text-white flex items-center gap-2 border-b border-slate-800 pb-2">
                    <i class="fa-solid fa-link text-emerald-400"></i> <span data-lang="linkAccountsTitle">ربط الحسابات ومنصات التسجيل</span>
                </h3>

                <div class="flex justify-between items-center bg-[#111622] p-2.5 rounded-xl border border-slate-800">
                    <span class="text-xs flex items-center gap-2"><i class="fa-brands fa-google text-rose-400"></i> Google Account</span>
                    <button onclick="toggleLink('google')" id="btnLinkGoogle" class="text-[10px] px-3 py-1.5 rounded-lg font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">متصل</button>
                </div>

                <div class="flex justify-between items-center bg-[#111622] p-2.5 rounded-xl border border-slate-800">
                    <span class="text-xs flex items-center gap-2"><i class="fa-brands fa-facebook text-blue-400"></i> Facebook Account</span>
                    <button onclick="toggleLink('facebook')" id="btnLinkFacebook" class="text-[10px] px-3 py-1.5 rounded-lg font-bold bg-slate-800 text-slate-400 border border-slate-700">ربط</button>
                </div>
            </div>

            <div class="bg-[#090d14] border border-slate-800 p-4 rounded-2xl space-y-3.5 shadow-lg">
                <h3 class="font-black text-xs text-white flex items-center gap-2 border-b border-slate-800 pb-2">
                    <i class="fa-solid fa-sliders text-emerald-400"></i> <span data-lang="appPreferences">تفضيلات التطبيق والألوان</span>
                </h3>

                <div class="flex justify-between items-center">
                    <span class="text-xs text-slate-300" data-lang="themeLabel">وضع الشاشة (ليلي / نهاري):</span>
                    <button onclick="toggleThemeMode()" id="themeModeBtn" class="text-[10px] bg-[#111622] border border-slate-700 px-3 py-1.5 rounded-xl text-emerald-400 font-bold">الوضع الليلي (Dark)</button>
                </div>

                <div class="flex justify-between items-center">
                    <span class="text-xs text-slate-300" data-lang="soundLabel">صوت واهتزاز الإشعارات:</span>
                    <button onclick="toggleSoundStatus()" id="soundStatusBtn" class="text-[10px] bg-[#111622] border border-slate-700 px-3 py-1.5 rounded-xl text-emerald-400 font-bold">مفعل (Sound On)</button>
                </div>

                <div class="flex justify-between items-center">
                    <span class="text-xs text-slate-300" data-lang="langLabel">لغة التطبيق (Language):</span>
                    <select id="langSelector" onchange="changeLanguage(this.value)" class="bg-[#111622] border border-slate-700 text-emerald-400 text-xs rounded-xl px-3 py-1.5 outline-none font-bold">
                        <option value="ar">العربية</option>
                        <option value="en">English</option>
                    </select>
                </div>
            </div>
        </section>

    </main>

    <!-- شريط التنقل السفلي -->
    <nav class="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-[#090d14]/95 backdrop-blur border-t border-slate-800 px-3 py-3 flex justify-around items-center z-50 shadow-2xl">
        <button onclick="openTab('profile')" id="nav-profile" class="flex flex-col items-center gap-1 text-slate-400 hover:text-emerald-400 text-[10px] font-bold transition">
            <i class="fa-solid fa-user-gear text-base"></i>
            <span data-lang="navProfile">الملف</span>
        </button>
        <button onclick="openTab('signals')" id="nav-signals" class="flex flex-col items-center gap-1 text-slate-400 hover:text-emerald-400 text-[10px] font-bold transition">
            <i class="fa-solid fa-chart-line text-base"></i>
            <span data-lang="navSignals">النتائج</span>
        </button>
        <button onclick="openTab('vision')" id="nav-vision" class="flex flex-col items-center gap-1 text-slate-400 hover:text-blue-400 text-[10px] font-bold transition">
            <i class="fa-solid fa-brain text-base"></i>
            <span data-lang="navVision">تحليل الشارت</span>
        </button>
        <button onclick="openTab('home')" id="nav-home" class="flex flex-col items-center gap-1 text-emerald-400 text-[10px] font-bold transition">
            <i class="fa-solid fa-chart-pie text-base"></i>
            <span data-lang="navHome">الرئيسية</span>
        </button>
    </nav>

    <!-- البرمجة والربط الحقيقي الواقعي -->
    <script>
        let currentSymbol = "OANDA:XAUUSD";
        let isDarkMode = true;
        let soundEnabled = true;
        let currentLang = 'ar';
        let linkedAccounts = { google: true, facebook: false };
        let uploadedChartImage = null;

        const translations = {
            ar: {
                serverLabel: "اختر الأصل / السوق:",
                scanningText: "الفحص الصارم عبر 10 مراحل",
                startScanBtn: "بدء الفحص الصارم (10 مراحل مضمونة)",
                resultsTitle: "نتائج استراتيجيات التداول الاحترافية",
                backBtn: "رجوع للشارت",
                noResults: "لم يتم إجراء فحص بعد. انقر على بدء الفحص الصارم من الشاشة الرئيسية.",
                settingsTitle: "الملف الشخصي والإعدادات الشاملة",
                fullNameLabel: "الاسم الكامل:",
                studioHint: "انقر على أيقونة الكاميرا لفتح استديو الهاتف واختيار صورتك الشخصية فوراً.",
                linkAccountsTitle: "ربط الحسابات ومنصات التسجيل",
                appPreferences: "تفضيلات التطبيق والألوان",
                themeLabel: "وضع الشاشة (ليلي / نهاري):",
                soundLabel: "صوت واهتزاز الإشعارات:",
                langLabel: "لغة التطبيق (Language):",
                visionTitle: "التحليل العميق للشارت (AI Deep Vision)",
                uploadTitle: "ارفع صورة الشارت لأي سوق تريده",
                uploadSub: "ذهب، عملات رقمية، مؤشرات، أسهم، أو فوركس",
                tfLabel: "الفريم الزمني الظاهر:",
                strategyFocusLabel: "الاستراتيجية المعتمدة:",
                startVisionBtn: "بدء الفحص الصارم للشارت",
                visionScanningText: "جاري فحص الـ 10 مراحل للشارت...",
                navHome: "الرئيسية",
                navVision: "تحليل الشارت",
                navSignals: "النتائج",
                navProfile: "الملف"
            },
            en: {
                serverLabel: "Select Asset / Market:",
                scanningText: "10-Stage Strict Scan",
                startScanBtn: "Start Strict Scan (10 Guaranteed Stages)",
                resultsTitle: "Professional Strategy Results",
                backBtn: "Back to Chart",
                noResults: "No scan performed yet. Click strict scan from home.",
                settingsTitle: "Profile & Comprehensive Settings",
                fullNameLabel: "Full Name:",
                studioHint: "Click the camera icon to open your phone gallery and choose your profile picture.",
                linkAccountsTitle: "Account Links & Registration",
                appPreferences: "App Preferences & Colors",
                themeLabel: "Screen Mode (Dark / Light):",
                soundLabel: "Notification Sound & Vibe:",
                langLabel: "App Language:",
                visionTitle: "AI Deep Chart Vision Analysis",
                uploadTitle: "Upload Chart Screenshot for any Market",
                uploadSub: "Gold, Crypto, Indices, Stocks, Forex",
                tfLabel: "Timeframe:",
                strategyFocusLabel: "Strategy Focus:",
                startVisionBtn: "Start Strict Chart Scan",
                visionScanningText: "Scanning 10 strict stages...",
                navHome: "Home",
                navVision: "Deep Vision",
                navSignals: "Results",
                navProfile: "Profile"
            }
        };

        function loadChart(symbol) {
            const container = document.getElementById('tv-chart-container');
            container.innerHTML = '';
            const script = document.createElement('script');
            script.src = "https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js";
            script.async = true;
            script.innerHTML = JSON.stringify({
                "width": "100%", "height": "100%", "symbol": symbol, "interval": "15",
                "timezone": "Etc/UTC", "theme": isDarkMode ? "dark" : "light", "style": "1", "locale": currentLang,
                "enable_publishing": false, "allow_symbol_change": false, "calendar": false,
                "hide_top_toolbar": true, "support_host": "https://www.tradingview.com"
            });
            container.appendChild(script);
        }

        function changeAsset(symbol) {
            currentSymbol = symbol;
            loadChart(symbol);
        }

        loadChart(currentSymbol);

        function openTab(tabName) {
            ['home', 'vision', 'signals', 'profile'].forEach(tab => {
                document.getElementById('tab-' + tab).classList.add('hidden');
                document.getElementById('nav-' + tab).classList.replace('text-emerald-400', 'text-slate-400');
                document.getElementById('nav-' + tab).classList.replace('text-blue-400', 'text-slate-400');
            });
            document.getElementById('tab-' + tabName).classList.remove('hidden');
            let activeNav = document.getElementById('nav-' + tabName);
            if(tabName === 'vision') {
                activeNav.classList.replace('text-slate-400', 'text-blue-400');
            } else {
                activeNav.classList.replace('text-slate-400', 'text-emerald-400');
            }
        }

        function pickImageFromStudio(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    let imageUrl = e.target.result;
                    let topImg = document.getElementById('topAvatarImg');
                    let topIcon = document.getElementById('topAvatarIcon');
                    let profImg = document.getElementById('profileImgDisplay');
                    let profIcon = document.getElementById('profileIconDisplay');

                    topImg.src = imageUrl; topImg.classList.remove('hidden'); topIcon.classList.add('hidden');
                    profImg.src = imageUrl; profImg.classList.remove('hidden'); profIcon.classList.add('hidden');
                }
                reader.readAsDataURL(file);
            }
        }

        function handleChartUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    uploadedChartImage = e.target.result;
                    let previewImg = document.getElementById('chartPreviewImg');
                    let previewBox = document.getElementById('chartPreviewContainer');
